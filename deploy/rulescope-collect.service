[Unit]
Description=rulescope FortiGate snapshot and change diff
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=rulescope
Group=rulescope
# Edit the host and the fingerprint (get it with: rulescope cert --host 192.168.1.99).
# Use --ca-file instead of --pin-sha256 if the FortiGate has a certificate from your CA.
# Alerts: put the webhook URL in /etc/rulescope/webhook (mode 600) and add --webhook-file /etc/rulescope/webhook.
ExecStart=/usr/local/bin/rulescope collect --host 192.168.1.99 --token-file /etc/rulescope/token --pin-sha256 PASTE_FINGERPRINT_HERE --out /var/lib/rulescope/snapshots --diff
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rulescope
PrivateTmp=yes
