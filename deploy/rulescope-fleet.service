[Unit]
Description=rulescope fleet audit, change tracking and dashboard
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=rulescope
Group=rulescope
# Alerts: put the webhook URL in /etc/rulescope/webhook (mode 600) and add --webhook-file /etc/rulescope/webhook;
# add --syslog host:514 for the SIEM.
# --advisories online needs outbound HTTPS to services.nvd.nist.gov; use "cache" on isolated networks.
# Optional NVD API key (raises the rate limit): put NVD_API_KEY=... in this file, mode 600.
EnvironmentFile=-/etc/rulescope/nvd.env
ExecStart=/usr/local/bin/rulescope fleet --inventory /etc/rulescope/fleet.ini --out /var/lib/rulescope/site --snapshots /var/lib/rulescope/snapshots --auditor "Security team" --advisories online --cache-dir /var/lib/rulescope/nvd-cache
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rulescope
PrivateTmp=yes
