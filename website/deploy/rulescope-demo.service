[Unit]
Description=Build the RuleScope demo website (static files from synthetic configs)
# Update the checkout first. If GitHub cannot be reached the fetch unit fails visibly
# (systemctl --failed) and the site is still built from the checkout that is there.
Wants=rulescope-demo-fetch.service
After=rulescope-demo-fetch.service

[Service]
Type=oneshot
User=rsdemo
Group=rsdemo
# /etc/rulescope-demo.env (mode 600):
#   SITE_URL=https://demo.example.com
#   ADVISORIES=off
EnvironmentFile=/etc/rulescope-demo.env
Environment=TZ=UTC HOME=/nonexistent
# -I: ignore PYTHON* variables and the user site. -B: write no .pyc files (the checkout is read-only here).
ExecStart=/usr/bin/python3 -I -B /opt/rulescope-fortigate/website/build.py --out /srv/rulescope-demo --site-url ${SITE_URL} --advisories ${ADVISORIES} --cache-dir /var/cache/rulescope-demo
TimeoutStartSec=5min
MemoryMax=256M
TasksMax=64
CPUQuota=50%
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/srv/rulescope-demo /var/cache/rulescope-demo
# The build needs no network: code from the repository cannot connect anywhere.
# For ADVISORIES=online (known CVEs from the NIST NVD) add a drop-in that sets
#   PrivateNetwork=no
#   RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
