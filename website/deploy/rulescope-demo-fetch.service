[Unit]
Description=Update the RuleScope checkout used by the demo website
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# A separate user owns the checkout. The build (rulescope-demo.service) runs as another user that
# can only read it, so code from the repository cannot change the checkout it will run from next.
User=rsfetch
Group=rsfetch
Environment=GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_SYSTEM=/dev/null GIT_TERMINAL_PROMPT=0 HOME=/nonexistent
# Not "git pull": the checkout is set to exactly what main is, hooks never run, leftovers are removed.
ExecStart=/usr/bin/git -C /opt/rulescope-fortigate -c core.hooksPath=/dev/null fetch --quiet --prune origin main
ExecStart=/usr/bin/git -C /opt/rulescope-fortigate -c core.hooksPath=/dev/null reset --quiet --hard FETCH_HEAD
ExecStart=/usr/bin/git -C /opt/rulescope-fortigate -c core.hooksPath=/dev/null clean -fdxq
TimeoutStartSec=2min
MemoryMax=256M
TasksMax=64
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/opt/rulescope-fortigate
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
